# Copy these values into the server-only .env.local after verifying a sender domain in Resend.
# Do not commit the real values. Restart elfred-mobile after editing.
ELFRED_RESEND_API_KEY=
ELFRED_EMAIL_FROM=
# Optional: a long random secret keeps pending codes valid across app restarts.
ELFRED_AUTH_CODE_SECRET=

# Optional SMS login through Twilio. Keep these values on the server only.
ELFRED_TWILIO_ACCOUNT_SID=
ELFRED_TWILIO_AUTH_TOKEN=
ELFRED_TWILIO_FROM=
