# Elfred PA Gateway — copy to .env and fill in. NEVER commit .env.

# --- planner (WP-06) ---
# deterministic | llm | letta
PA_PLAN_PROVIDER=deterministic
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-flash
# disabled keeps planning fast (thinking mode costs ~2.5x latency here)
PA_LLM_THINKING=disabled

# --- Letta App Server (WP-01) ---
# `letta server --listen ws://0.0.0.0:4500 --openai-api --ws-auth capability-token`
# LETTA_AGENT_ID = the agent's real id (stored on the PA profile)
# LETTA_MODEL    = the model handle the App Server exposes (= the agent name)
LETTA_URL=http://127.0.0.1:4500
LETTA_AGENT_ID=
LETTA_MODEL=
LETTA_API_KEY=

# --- existing services ---
EMOS_URL=http://127.0.0.1:8000
ORGANIZER_URL=http://127.0.0.1:8770
MOBILE_URL=http://127.0.0.1:5173

# --- WP-05 desktop intake (Elfred Desktop Observer) ---
# The Observer screenshots/OCRs locally and applies its own privacy gate; the
# gateway reads the events it allowed. Keep the port off 8765 (Skill Foundry).
OBSERVER_URL=http://127.0.0.1:8781

# --- WP-08 task authority and skills ---
TASK_HOST_URL=http://127.0.0.1:8001
SKILL_URL=http://127.0.0.1:8765

# --- WP-08 delegation (execution book: opencode_delegate) ---
# Example: codex exec --sandbox read-only --skip-git-repo-check --ephemeral
# or:      opencode run
PA_DELEGATE_CMD=
PA_DELEGATE_WORKSPACE=
PA_DELEGATE_TIMEOUT=180

# --- policy ---
PA_MAX_STEPS=10
PA_TOOL_TIMEOUT=15

# --- storage ---
PA_GATEWAY_DB=pa-gateway.db
