{
  "name": "elfred-mobile",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev:local": "node --env-file-if-exists=.env.local scripts/start-local.mjs",
    "test:runtime": "node --experimental-strip-types --test tests/elfred/*.test.mjs",
    "seed:fixtures": "node scripts/seed-feed-fixtures.mjs",
    "build:local": "next build",
    "start:local": "node --env-file-if-exists=.env.local scripts/start-local.mjs --production",
    "dev": "node scripts/run-project.mjs dev",
    "build": "node scripts/run-project.mjs build",
    "start": "node scripts/run-project.mjs start",
    "test": "node tests/run-product-tests.mjs",
    "typecheck": "node scripts/run-project.mjs typecheck",
    "lint": "node scripts/run-project.mjs lint",
    "db:generate": "node scripts/run-project.mjs db:generate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "lucide-react": "1.31.0",
    "mdast-util-from-markdown": "2.0.3",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "displayName": "Elfred Mobile"
}
