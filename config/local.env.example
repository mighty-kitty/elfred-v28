# Copy to .env.local at repository root. Never put credentials in chat or Git.
ELFRED_PORT=3000
# ELFRED_DATA_DIR=D:/private/elfred-data
# Chat Completions compatible endpoint base, normally ending in /v1.
ELFRED_MODEL_BASE_URL=
ELFRED_MODEL_NAME=
ELFRED_MODEL_API_KEY=
# External monetary pricing is not inferred. Local quota units are not currency.

# 三个上游服务（源码在 services/ 下，可选）。不配地址时设置页如实显示"尚未配置"，
# 应用本身的功能照常可用；配了就按下面的端口探活。
# 记忆中枢（EMOS）：python -m src.memory_system.api.server
ELFRED_MEMORY_HUB_URL=
ELFRED_MEMORY_HUB_TOKEN=
# Skill Foundry（能力卡组的生成与版本）：python -m adapter
ELFRED_SKILL_FOUNDRY_URL=
# PA 网关（规划与执行）：python -m uvicorn app.main:app
ELFRED_PA_GATEWAY_URL=
