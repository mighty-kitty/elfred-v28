# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
next-env.d.ts
/dist/
/.wrangler/
/.sites-runtime/
/outputs/
/work/
*.tsbuildinfo
/.elfred-data/
/.qa-data/
/test-results/
/playwright-report/

# vinext generated fonts/styles
/.vinext/

# runtime logs
*.log

# one-off refactor audit artifacts
_dead-css-report.json
_removed-classes.json
# not part of the frontend refactor (backend handover; out of scope)
*后端开发说明.md

# scratch artifacts from refactor verification
_shot-*.png
_render-*.txt

# generated frontend artifacts
.vinext/
.sites-runtime/
.wrangler/
dist/
tsconfig.tsbuildinfo

# 我们自己的 QA 截图证据（不进 PR，留在本地/内测版仓库）
docs/证据-*/

