ELFRED_ADAPTER_HOST=127.0.0.1
ELFRED_ADAPTER_PORT=8765
ELFRED_ADAPTER_DB=./data/elfred_adapter.db
FREETODO_BASE_URL=http://127.0.0.1:8001
OBSERVER_BASE_URL=http://127.0.0.1:8000
ELFRED_CONTEXT_BACKEND=freetodo
ELFRED_LLM_PROVIDER=deterministic
ELFRED_SKILL_CLASSIFICATION_PROVIDER=auto
ELFRED_SKILL_CLASSIFICATION_MAX_CHARS=2400
ELFRED_JOURNAL_ENABLED=false
ELFRED_JOURNAL_MAX_EVENTS=30
ELFRED_JOURNAL_WORKER_INTERVAL=2
ELFRED_JOURNAL_LEASE_SECONDS=600
ELFRED_JOURNAL_MAX_ATTEMPTS=6
ELFRED_JOURNAL_RETRY_BASE_SECONDS=10
ELFRED_HARDWARE_OUTPUT_ENABLED=true
ELFRED_HARDWARE_AUTO_PLAN_ON_JOURNAL=true
ELFRED_HARDWARE_CONFIG=./config/hardware_output.local.json
ELFRED_HARDWARE_LLM_ENABLED=false
ELFRED_HARDWARE_WORKER_INTERVAL=0.5
ELFRED_HARDWARE_HTTP_TIMEOUT=5
ELFRED_HARDWARE_MAX_ATTEMPTS=2
# Required only when a device uses transport=xiao. Keep the real token local.
XIAO_PENDANT_TOKEN=
